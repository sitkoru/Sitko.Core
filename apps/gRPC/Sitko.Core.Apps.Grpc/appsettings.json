{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Web": {
      "Ports": {
        "Http": {
          "Port": 18080,
          "Protocol": "Http1",
          "UseTLS": true
        },
        "gRPC": {
          "Port": 18081,
          "ExternalAddress": "localhost",
          "Protocol": "Http2",
          "UseTLS": true
        }
      }
    },
    "Environment": "grpc-demo"
  },
  "ServiceDiscovery": {
    "Consul": {
      "Address": "http://127.0.0.1:18500",
      "DnsServers": [
        "127.0.0.1:18600"
      ]
    }
  },
  "Grpc": {
    "Client": {
      "Default": {
        "DefaultDeadline": "00:00:10"
      }
    }
  }
}

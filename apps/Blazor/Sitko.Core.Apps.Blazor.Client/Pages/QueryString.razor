@page "/QueryString"
@inherits BaseComponent
@rendermode InteractiveAuto

<AppPageLayout Title="Параметр URL">
    <MudText Class="mb-4">Значение GUID читается из параметра test в текущем URL. Без параметра показан пустой GUID.</MudText>
    <MudText Class="mb-4" role="status">GUID: @Test</MudText>
    <MudLink Href="@($"/QueryString?test={Guid.NewGuid()}")">Сменить значение</MudLink>
    <MudText Class="mt-4">Смените значение несколько раз, затем используйте «Назад» и обновление страницы в браузере: значение соответствует текущему URL.</MudText>
</AppPageLayout>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "test")]
    public Guid Test { get; set; }
}

@page "/"
@rendermode InteractiveAuto
@inherits BaseComponent

<AppPageLayout Title="Демонстрация Sitko.Core Blazor">
    <MudText Class="mb-4">Формы, валидация, навигация и загрузка файлов на компонентах Sitko.Core и MudBlazor. Пример работает локально без базы данных и внешних сервисов.</MudText>
    <MudStack Spacing="3">
        <MudLink Href="/Form">Форма: обязательное имя, отправка и сброс</MudLink>
        <MudLink Href="/Files">Файлы: одиночная и множественная загрузка, просмотр изображения</MudLink>
        <MudLink Href="/QueryString">Параметры URL: смена значения, назад и обновление</MudLink>
    </MudStack>
    <MudText Class="mt-4">Страницы используют InteractiveAuto: первое открытие работает на сервере, последующие — в WebAssembly после его загрузки.</MudText>
</AppPageLayout>
